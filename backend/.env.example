# =============================================================================
# VCIS — Virtual Campus Intelligence System
# Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# Never commit the actual .env file or real secrets to version control.

# Database Connection URL (PostgreSQL in production, SQLite supported for testing)
# Example PostgreSQL: postgresql+psycopg://username:password@localhost:5432/vcis_db
# Example SQLite: sqlite:///./vcis.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vcis_db

# Cryptographic secret key for signing and validating JWT tokens (must be a strong, random 256-bit+ secret)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-min-32-chars

# JWT Signing Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT Token Expiration in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed origins for CORS (no trailing slashes, no wildcard '*')
# In production, include your Netlify frontend domain (e.g. https://your-site.netlify.app)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
